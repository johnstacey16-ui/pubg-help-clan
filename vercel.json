{
  "version": 2,
  "ignoreCommand": "node scripts/vercel-deployment-gate.mjs",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "design/**",
      "use": "@vercel/static"
    },
    {
      "src": "training/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/interactions",
      "dest": "api/index.js"
    },
    {
      "src": "/api/sync",
      "dest": "api/sync.js"
    },
    {
      "src": "/api/health",
      "dest": "api/health.js"
    },
    {
      "src": "/api/public-stats",
      "dest": "api/public-stats.js"
    },
    {
      "src": "/api/player-lookup",
      "dest": "api/player-lookup.js"
    },
    {
      "src": "/api/player-refresh",
      "dest": "api/player-refresh.js"
    },
    {
      "src": "/api/public-season",
      "dest": "api/public-season.js"
    },
    {
      "src": "/api/public-progress",
      "dest": "api/public-progress.js"
    },
    {
      "src": "/api/public-season-leaderboard",
      "dest": "api/public-season-leaderboard.js"
    },
    {
      "src": "/api/player-history",
      "dest": "api/player-history.js"
    },
    {
      "src": "/api/public-matches",
      "dest": "api/public-matches.js"
    },
    {
      "src": "/api/public-insights",
      "dest": "api/public-insights.js"
    },
    {
      "src": "/api/public-source",
      "dest": "api/public-insights.js"
    },
    {
      "src": "/api/public-telemetry",
      "dest": "api/public-matches.js"
    },
    {
      "src": "/api/public-global-leaderboard",
      "dest": "api/public-insights.js"
    },
    {
      "src": "/training",
      "status": 308,
      "headers": {
        "Location": "/training/"
      }
    },
    {
      "src": "/training/",
      "dest": "/training/index.html"
    },
    {
      "src": "/training/(.*)",
      "dest": "/training/$1"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/design/(.*)",
      "dest": "/design/$1"
    },
    {
      "src": "/dashboard",
      "status": 308,
      "headers": {"Location": "/dashboard/"}
    },
    {
      "src": "/dashboard/",
      "dest": "/training/index.html"
    },
    {
      "src": "/",
      "dest": "/training/index.html"
    },
    {
      "src": "/index.html",
      "status": 308,
      "headers": {"Location": "/dashboard/"}
    }
  ],
  "crons": [
    {
      "path": "/api/sync",
      "schedule": "0 5 * * *"
    }
  ]
}
